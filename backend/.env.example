# Backend environment variables
# Copy to .env and fill in real values. NEVER commit .env to Git.

# Server
PORT=5000
NODE_ENV=development

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173

# TiDB Cloud MySQL connection string (keep strictly on the backend)
# Note: TiDB Cloud serverless permits DDL only in the "test" database.
DATABASE_URL="mysql://user:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/test"

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
